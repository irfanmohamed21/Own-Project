# Frontend origins allowed to call this API. Add the deployed frontend origin
# here when hosting the backend separately.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CPU is the portable default. For CUDA hosts, use WHISPER_DEVICE=cuda and
# select a supported compute type for the installed CUDA/CTranslate2 versions.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_BYTES=104857600

# Optional: store downloaded faster-whisper model files in this directory.
# WHISPER_MODEL_DIR=./models
